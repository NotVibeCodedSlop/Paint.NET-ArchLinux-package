
[Desktop Entry]
Name=Paint.NET
GenericName=Image Editor
Comment=Image editing software running through Wine
Exec=/usr/bin/paintdotnet %F
Icon=/opt/paintnetwine/paintdotnet.ico
Terminal=false
Type=Application
Categories=Graphics;RasterGraphics;2DGraphics;
StartupNotify=true
MimeType=image/png;image/jpeg;image/bmp;image/gif;image/tiff;

